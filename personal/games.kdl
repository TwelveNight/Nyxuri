// Personal game rules copied from iNiR, loaded after application rules.
// Inspect actual app-id/title with `niri msg windows`: Proton sideloads can
// share steam_app_default, so always pair that ID with the game's main title.
// Do not fullscreen Heroic, every Wine window, or Windows launchers/dialogs.
// Keep the game on the 100% output to avoid Wine buffer-size mismatches.
// https://niri-wm.github.io/niri/Configuration%3A-Window-Rules.html

// Arknights: Heroic + Proton-CachyOS currently uses steam_app_default on
// native Wine Wayland. Also recognize executable IDs used by Wine/Xwayland.
window-rule {
    match app-id=r#"(?i)^(steam_app_default|(?:wine\.)?arknights(?:\.exe)?)$"# title=r#"^(明日方舟|Arknights)$"#

    // Start on the 100% external output so Wine chooses its size at launch.
    // Niri falls back to an available output if this monitor is disconnected.
    open-on-output "HDMI-A-1"
    // Match Mod+Shift+O, with tiling as the layout after leaving fullscreen.
    open-floating false
    open-fullscreen true
    geometry-corner-radius 0
    clip-to-geometry false
    opacity 1.0
    border { off; }
    focus-ring { off; }
    shadow { off; }
}
