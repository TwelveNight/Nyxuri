[Unit]
Description=Nyxuri private Niri session
Conflicts=niri.service
BindsTo=graphical-session.target
Before=graphical-session.target xdg-desktop-autostart.target
Wants=graphical-session-pre.target xdg-desktop-autostart.target nyxuri-shell.service nyxuri-clipboard.service
After=graphical-session-pre.target

[Service]
Type=notify
Slice=session.slice
Environment=XDG_CURRENT_DESKTOP=niri XDG_SESSION_DESKTOP=niri
Environment=XCURSOR_THEME=Bibata-Modern-Classic XCURSOR_SIZE=24
ExecStart=/usr/bin/env -u WAYLAND_DISPLAY -u DISPLAY -u NIRI_SOCKET -u HYPRLAND_INSTANCE_SIGNATURE -u AQ_DRM_DEVICES -u WLR_NO_HARDWARE_CURSORS -u WLR_DRM_NO_ATOMIC -u LIBVA_DRIVER_NAME -u __GL_VRR_ALLOWED -u DRI_PRIME -u __NV_PRIME_RENDER_OFFLOAD -u __GLX_VENDOR_LIBRARY_NAME -u __VK_LAYER_NV_optimus -u __EGL_VENDOR_LIBRARY_FILENAMES -u VK_LOADER_DRIVERS_DISABLE -u MESA_VK_DEVICE_SELECT -u MESA_VK_DEVICE_SELECT_FORCE_DEFAULT_DEVICE -u VDPAU_DRIVER -u QT_FFMPEG_DECODING_HW_DEVICE_TYPES -u INIR_SHELL_GPU_PREFERENCE /usr/bin/niri --session --config %h/.config/nyxuri-desktop/niri/config.kdl
