// Keep clear wallpaper in each workspace and a blurred copy behind them.
overview {
    zoom 0.75
    backdrop-color "transparent"
    workspace-shadow {
        on
    }
}

// Follow the active iNiR native overview animation.
animations {
    overview-open-close {
        spring damping-ratio=1.0 stiffness=900 epsilon=0.0001
    }
}

// The normal wallpaper zooms out with each workspace.
layer-rule {
    match namespace="^skwd-(paper|wall-vk|wall-still)$"
    place-within-backdrop false
}

// Noctalia renders and caches the blurred copy independently of its wallpaper.
layer-rule {
    match namespace="^noctalia-backdrop"
    place-within-backdrop true
}
