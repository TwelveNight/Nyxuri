[Unit]
Description=Synchronize skwd-wall changes with II and Matugen
Requires=skwd-walld.service
After=skwd-walld.service
PartOf=hyprland-session.target

[Service]
Type=simple
ExecStart=%h/.config/quickshell/ii/scripts/colors/skwd-wall-theme-listener.sh
Restart=always
RestartSec=3

[Install]
WantedBy=hyprland-session.target
